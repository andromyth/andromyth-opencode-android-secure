{
  "policy_version": 2,
  "application_repository": "andromyth/andromyth-opencode-android-secure",
  "official_engine": {
    "repository": "anomalyco/opencode",
    "url": "https://github.com/anomalyco/opencode.git",
    "default_branch": "dev",
    "commit": "b958fc84d73e34a2fa021c285cd38c6de674adb9",
    "allow_forks": false,
    "release_builds_require_pinned_commit": true
  },
  "official_native_dependencies": [
    {
      "repository": "anomalyco/opentui",
      "url": "https://github.com/anomalyco/opentui.git",
      "default_branch": "main",
      "commit": "ff939592dc7bd102a4665bf340c4960b868b306b",
      "role": "Official terminal UI and native renderer; build from source for Android ARM64"
    },
    {
      "repository": "ghostty-org/ghostty",
      "url": "https://github.com/ghostty-org/ghostty.git",
      "commit": "ab0b9da9e88fcb4b0533a1854e84628f663930af",
      "role": "Pinned Ghostty VT source used by the official OpenCode PTY daemon build"
    },
    {
      "repository": "dmtrKovalenko/fff",
      "url": "https://github.com/dmtrKovalenko/fff.git",
      "default_branch": "main",
      "role": "Official FFF native file-search dependency; npm artifact locked by the official OpenCode bun.lock"
    }
  ],
  "official_build_tools": [
    {
      "repository": "oven-sh/bun",
      "url": "https://github.com/oven-sh/bun.git",
      "release": "bun-v1.4.4",
      "role": "Official Bun Android ARM64 runtime used to compile the OpenCode CLI"
    },
    {
      "repository": "ziglang/zig",
      "url": "https://github.com/ziglang/zig.git",
      "version": "0.17.1",
      "role": "Official Zig compiler used to build OpenTUI native renderer"
    }
  ],
  "approved_source_repositories": [
    "anomalyco/opencode",
    "anomalyco/opentui",
    "ghostty-org/ghostty",
    "dmtrKovalenko/fff",
    "oven-sh/bun",
    "ziglang/zig"
  ],
  "approved_github_actions": [
    "actions/checkout",
    "actions/setup-java",
    "actions/upload-artifact",
    "gradle/actions",
    "mlugg/setup-zig"
  ],
  "legacy_compatibility_payload": {
    "release_tag": "standalone-payload-v1",
    "asset": "oc_pkg.bin",
    "sha256": "6384e745af0ee988a6f51e8aa205c0d71b614e0bb100d22c4e535b355d673a7d",
    "status": "frozen_compatibility_only",
    "approved_for_engine_updates": false,
    "approved_for_new_features": false,
    "note": "Frozen compatibility artifact retained only until the official OpenCode CLI, PTY daemon and OpenTUI renderer are built from the pinned official sources. It is not an approved engine source and must not be modified, extended or used as the basis for new features."
  },
  "enforcement": {
    "unknown_or_forked_engine_repositories": "deny",
    "unlisted_github_actions": "deny",
    "unapproved_runtime_binary_sources": "deny",
    "feature_or_settings_removal_without_explicit_approval": "deny"
  }
}
